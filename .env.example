# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Embedding model for fastembed (downloaded once, about 220 MB). Leave as is unless you know it is supported.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Admin code for the admin panel (sign in at /api/admin/login). Change it.
ADMIN_CODE=qazaq-admin
# Public address of the frontend, encoded in the event QR code. Use your LAN IP so phones can scan it.
PUBLIC_URL=http://localhost:3000
